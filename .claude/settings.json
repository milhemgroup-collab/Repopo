      "Bash(git diff:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(date:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "mcp__ce104558-397b-4e61-bb0e-dc7735a669f3__notion-fetch",
      "mcp__ce104558-397b-4e61-bb0e-dc7735a669f3__notion-search",
