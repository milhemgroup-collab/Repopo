{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/notify-on-stop.sh\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Sending routine summary to Gmail..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash $CLAUDE_PROJECT_DIR/scripts/notify-on-stop.sh:*)",
      "Bash(curl -sS *)",
      "Bash(curl -s *)",
      "Bash(python3 *)"
    ]
  }
}
